{
  "name": "betterviewer",
  "version": "3.0.2",
  "description": "A browser extension for better image viewing experience",
  "author": "Adem Kouki <ademkouki.tn@gmail.com> (https://github.com/Ademking/BetterViewer)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ademking/BetterViewer.git"
  },
  "keywords": [
    "betterviewer",
    "image",
    "viewer",
    "browser",
    "extension",
    "better"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "emoji-data": "node scripts/build-emoji-data.mjs",
    "build:ext": "vite build --mode extension && node scripts/build-extension.mjs"
  },
  "manifest": {
    "browser_specific_settings": {
      "gecko": {
        "id": "ademking@betterviewer"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "emojibase-data": "^17.0.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.2",
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.3.0",
    "@nuintun/qrcode": "^5.0.3",
    "clsx": "^2.1.1",
    "exif-js": "^2.3.0",
    "konva": "^10.7.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  }
}
